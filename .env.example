# Google OAuth (required for sign-in)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: restrict sign-in domain (default: antiguais.org)
# VITE_ALLOWED_EMAIL_DOMAINS=antiguais.org

# Vercel Postgres (Neon) — use the POOLED URL (hostname contains -pooler)
# Auto-set on Vercel when Storage is linked. Do NOT use POSTGRES_URL_NON_POOLING.
# POSTGRES_URL=postgres://...@ep-xxx-pooler.region.aws.neon.tech/...
