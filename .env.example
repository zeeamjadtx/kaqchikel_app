# Google OAuth (required for sign-in)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: restrict sign-in domain (default: antiguais.org)
# VITE_ALLOWED_EMAIL_DOMAINS=antiguais.org

# Vercel Postgres — auto-set on Vercel; copy to .env.local for local API testing
# POSTGRES_URL=postgres://...
